{
  "name": "offline-field-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Offline English-Swahili field assistant for clinic intake staff (headless core).",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "bin": {
    "ofa": "src/cli/ofa.ts"
  },
  "scripts": {
    "ofa": "tsx src/cli/ofa.ts",
    "fetch-models": "tsx scripts/fetch-models.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/unit",
    "test:models": "vitest run --dir tests/models --no-file-parallelism",
    "eval": "npm run eval:translate && npm run eval:stt && npm run eval:tts && npm run eval:converse && npm run eval:packs && npm run eval:phrasebook && npm run eval:guide && npm run eval:documents && npm run eval:platform",
    "eval:translate": "tsx eval/run-translate.ts",
    "electron:smoke": "electron .",
    "package": "electron-forge package --arch=arm64",
    "audit:net": "scripts/net-audit.sh",
    "fetch-fleurs": "tsx scripts/fetch-fleurs.ts",
    "eval:make-intake-audio": "tsx eval/make-intake-audio.ts",
    "eval:stt": "tsx eval/run-stt.ts",
    "import-paza": "tsx scripts/import-paza.ts",
    "eval:tts": "tsx eval/run-tts.ts",
    "eval:converse": "tsx eval/run-converse.ts",
    "eval:packs": "tsx eval/run-packs.ts",
    "make-phrase-recordings": "tsx scripts/make-phrase-recordings.ts",
    "eval:phrasebook": "tsx eval/run-phrasebook.ts",
    "eval:guide": "tsx eval/run-guide.ts",
    "eval:documents": "tsx eval/run-documents.ts",
    "eval:platform": "tsx eval/run-platform.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@qvac/sdk": "0.21.0",
    "pdfjs-dist": "6.4.299",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-base": "7.11.2",
    "@types/node": "26.6.5",
    "electron": "44.7.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "main": "electron/main.mjs",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "3.4.0"
    }
  }
}
